# 复制为 .env.local 后填写本机配置；.env.local 已被 Git 忽略。
# JWT 密钥使用至少 32 个随机字符；不要提交真实密钥。
IAM_JWT_SECRET=

# 与 compose.yaml 的本地开发数据库一致。
JAVA_ADMIN_STARTER_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3300/java_admin_starter_iam?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
JAVA_ADMIN_STARTER_DATASOURCE_USERNAME=root
JAVA_ADMIN_STARTER_DATASOURCE_PASSWORD=root
